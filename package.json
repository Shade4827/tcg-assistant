{
  "name": "tcg-assistant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vp preview",
    "build-only": "vp build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "vp lint . --fix",
    "lint:eslint": "vp lint . --fix",
    "format": "vp fmt src/",
    "deploy": "vp build && wrangler deploy",
    "prepare": "vp config"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@tsconfig/node24": "^24.0.6",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.4",
    "typescript": "~6.0.3",
    "vite": "catalog:",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plus": "catalog:",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.164.0"
  },
  "engines": {
    "node": "^24.22.1"
  },
  "packageManager": "pnpm@12.21.0"
}
